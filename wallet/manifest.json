{
  "manifest_version": 3,
  "name": "Machinepay",
  "version": "1.0",
  "description": "Machinepay x402 wallet",
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["styles.css"]
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Machinepay Wallet"
  }
}